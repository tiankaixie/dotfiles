# Ghostty Configuration - NERV Theme
# https://ghostty.org/docs

# Font settings
font-family=Berkeley Mono
font-family-bold=Berkeley Mono
font-family-italic=Berkeley Mono
font-family-bold-italic=Berkeley Mono
font-size=13

# No theme - using custom NERV colors directly
# All colors defined inline to avoid theme conflicts

# NERV Core Colors
background=#0a1612
foreground=#8fb3a5

# Cursor
cursor-color=#e85d04
cursor-text=#0a1612

# Selection
selection-background=#2a1a0f
selection-foreground=#a8d3c5

# ANSI Colors (0-15) - NERV Palette
palette=0=#0f1f1a
palette=1=#c92a2a
palette=2=#4a8c5c
palette=3=#d4a017
palette=4=#3a7a8c
palette=5=#8a5a8a
palette=6=#5a9a8c
palette=7=#8fb3a5
palette=8=#4a6a5d
palette=9=#dc3545
palette=10=#5aac6c
palette=11=#e4b027
palette=12=#4a8a9c
palette=13=#9a6a9a
palette=14=#6aaa9c
palette=15=#a8d3c5

# Background effects - cyberpunk aesthetic
background-opacity=0.92
background-blur-radius=20

# Shell
command=/bin/zsh

# Behavior
click-repeat-interval=500
auto-update-channel=stable

# Window settings
window-padding-x=8
window-padding-y=8

# Cursor
cursor-style=block
cursor-style-blink=true
